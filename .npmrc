# Allege chaque "npm install" (racine ET apps/*, npm cherche ce fichier en remontant
# depuis le cwd) sur l'hebergement mutualise : moins d'appels reseau et de travail CPU
# pendant l'install racine, qui enchaine directement avec le postinstall (voir
# scripts/install-apps.js) dans le meme process npm — reduit le risque de depasser un
# timeout/quota de l'hebergeur en cours d'ecriture et de laisser un node_modules
# corrompu derriere (cause probable des erreurs ERR_INVALID_PACKAGE_CONFIG observees).
audit=false
fund=false
prefer-offline=true
